      }
    ],
    "safety_limits": [
      {
        "limit_id": "L01",
        "text": "不得为了降低耗电而采用可能使牛奶、熟食、剩菜或冷冻肉脱离安全保存温度的设置或做法。",
        "severity": "hard"
      }
