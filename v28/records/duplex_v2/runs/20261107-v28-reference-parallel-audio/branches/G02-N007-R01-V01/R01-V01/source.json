  "situation_knowledge": {
    "episode_situation": "周六上午，窗外下着小雨，用户在自家厨房整理近期家庭开支时注意到用电支出有所上升，于是想先弄明白三口之家每天都在使用的冰箱有哪些常见节能办法。家里常备牛奶、熟食、剩菜和冷冻肉，用户不愿以缩短食品安全保存时间为代价，也担心过于严格地限制开门会给家人取用食物带来不便。开始对话前，用户已经看过冰箱的温度显示，简单检查了机身与墙面的间距、冷冻室结霜和内部装载情况，但不清楚这些因素分别会造成多大影响。用户希望先尝试无需购买设备、容易坚持的调整，同时仍需逐步确认安全温度范围、通风间距、除霜时机、合理装载程度，以及频繁开门和一次开门较久之间应怎样取舍。",
    "task_reference_data": [
      "来自冰箱面板、用户当前已读到的显示：冷藏室设为3℃，冷冻室设为-20℃；用户尚未核实箱内实际温度是否与显示一致。",
      "来自用户刚才用直尺做的现场粗测：冰箱背面与墙面约有4厘米间距，顶部约有3厘米空隙；用户手边没有该型号说明书，尚不清楚厂家要求。",
      "来自用户打开冰箱后的现场观察：冷冻室内壁局部霜层约5毫米，冷藏室大约装到八成，部分容器靠近后壁出风位置；这些只是目测结果。"
    ],
    "environment_audio": "厨房窗外传来连续而轻柔的雨声，主要位于侧后方，音量稳定。室内整体较安静，雨声隔着玻璃显得低沉，不会持续盖过近距离说话声。",
    "estimated_snr_db": 28,
    "constraints": [
      {
        "constraint_id": "C01",
        "text": "优先比较无需购买新设备、能够立即尝试且容易长期坚持的调整。",
        "kind": "soft"
      },
      {
        "constraint_id": "C02",
        "text": "节能建议需要兼顾三口之家频繁取用食物的实际便利性。",
