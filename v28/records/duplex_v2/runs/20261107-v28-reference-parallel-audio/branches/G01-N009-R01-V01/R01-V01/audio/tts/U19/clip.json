            "language": "Chinese",
            "voice_setting": {
              "voice_id": "qwen3-profile-fcdbffd77192046e",
              "seed": 103222577,
              "voice_profile": "女性，感知三十多岁，音色明亮但略带紧绷感，吐字清楚，语速偏快，情绪起伏会自然地反映在语气里。",
              "reference_text": "我现在工作和家里的事情一多，就会觉得每件都很急，注意力来回跳。按顺序做不行，先做简单的也只是划掉得多。你能不能陪我找一套更适合我的处理思路？",
              "reference_directory": "/ytech_m2v8_hdd/workspace/kling_mm/zhengyuanhong/read_paper/全双工/duplex-env-scaling-package/project/duplex_v2/runs/20261107-v28-reference-parallel-audio/branches/G01-N009-R01-V01/R01-V01/audio/voices/user-reference",
