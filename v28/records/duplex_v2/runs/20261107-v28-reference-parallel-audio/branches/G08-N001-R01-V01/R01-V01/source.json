  "situation_knowledge": {
    "episode_situation": "周六晚上，用户在家完成当天的膝部康复训练后，想在下次复诊前养成稳定的记录习惯。她平日要上班，过去只在纸质笔记本里零散写过几句，训练后最多愿意花两分钟记录。她手边有康复人员给的动作单和笔记本，但没有穿戴设备，也不清楚疼痛应在训练前、训练后还是第二天记。她还拿不准疲劳、动作完成度和上下楼变化该怎样描述，以及哪些情况可以留到随访、哪些不宜等待。",
    "task_reference_data": [
      "来源于用户手边可现场读取的纸质动作单：每日一次，包括脚跟滑动每组10次、做2组；股四头肌收紧每次保持5秒、每组10次、做2组；坐站练习每组8次、做2组。",
      "来源于用户已写下但未系统整理的笔记本：最近只有“做完有点酸”“第二天腿累”和“下楼时更疼”三句，没有日期、疼痛分值或持续时间。",
      "用户目前能自行观察训练是否做完、是否减少次数、是否需要扶稳，以及训练前后和第二天的主观感受；动作角度等精确测量数据目前不可用。"
    ],
    "environment_audio": "室内整体安静，近处只有很轻且稳定的房间底噪。周围没有持续可辨的人声或突发声响。",
    "estimated_snr_db": 35,
    "constraints": [
      {
        "constraint_id": "C01",
        "text": "记录方法应适合写在纸质笔记本中，并尽量控制在每次训练后两分钟以内。",
        "kind": "hard"
      }
    ],
    "safety_limits": [
      {
        "limit_id": "L01",
        "text": "若出现胸痛、呼吸困难等急性危险表现，不应等待常规康复随访，应立即寻求紧急医疗帮助。",
        "severity": "critical"
      },
      {
        "limit_id": "L02",
        "text": "若膝部疼痛或肿胀明显加重、突然不能负重，或出现明显发红发热、发热、单侧小腿异常肿痛，不应仅靠继续记录或勉强训练来观察，应及时联系医疗人员评估。",
        "severity": "hard"
      }
    ],
