    "situation_knowledge": {
      "episode_situation": "今晚下雨，用户独自在租住的公寓客厅里，准备在成年兔到家前先弄清室内居住环境的基本安排。用户已经量过客厅一角并画了简图，注意到地面是光滑瓷砖，附近有窗户和落地扇，但还没有购买围栏、地垫或休息窝。由于租房不能钻孔或永久改动地面，用户需要在有限空间内兼顾日常活动、通风、防滑、安静休息和清洁便利。用户目前不确定活动区应怎样划分、开窗或使用风扇时如何避免直吹，也想提前知道兔子出现哪些活动、姿势、呼吸或排泄变化时，应调整环境或考虑健康问题。",
      "task_reference_data": [
        "用户手边的测量简图标注：可布置区域约为1.8米×1.4米，位于客厅靠墙一角；这是用户今晚自行测量的结果。",
        "用户现场观察到：该区域铺光滑瓷砖，右侧约1米处有一扇可开启的窗，落地扇通常放在窗边；风扇是否适合对着兔区使用尚未确认。",
        "租房合同中的现行限制是不得在墙面钻孔，也不得用难以清除的胶永久粘贴地板；可移动围栏、可清洗垫子和独立休息窝不受此限制。"
      ],
      "environment_audio": "窗外连续雨声隔着玻璃低低铺开，强弱较均匀。更远处偶尔传来被雨声压低的道路车流，整体不影响近距离说话。",
      "estimated_snr_db": 28,
      "constraints": [
        {
          "constraint_id": "C01",
          "text": "居住环境方案不得依赖墙面钻孔或对地板进行永久粘贴和改造。",
          "kind": "hard"
        },
        {
          "constraint_id": "C02",
          "text": "布置需适配约1.8米×1.4米的现有客厅区域，并保留可清洁、可调整的特点。",
          "kind": "hard"
        }
      ],
      "safety_limits": [
        {
          "limit_id": "L01",
          "text": "风扇、开窗和通风安排不能让兔子长期承受强烈直吹，电线等可啃咬物也不能暴露在其活动范围内。",
          "severity": "hard"
        },
