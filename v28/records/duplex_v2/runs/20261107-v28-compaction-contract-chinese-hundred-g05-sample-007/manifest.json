      "example_tasks": {
        "开放式互动": [
          "讨论乡村公共便利与水土生态保护之间如何取得平衡，并逐步形成适合日常生活的判断原则",
          "扮演村民议事会中的不同立场，练习围绕公共空间使用冲突展开协商",
          "通过问答和情境练习，提升向不同年龄和观念的村民解释环境保护必要性的表达能力",
          "共同创作一套面向儿童的乡村自然观察活动，让孩子认识身边的土地、水体和生物",
          "复盘一次极端天气可能带来的生活影响，讨论家庭和社区可以培养哪些应对思路"
        ],
        "结构化整理": [
          "把随后提供的村庄公共事务按影响范围、紧迫程度和责任主体分类，并整理成议事清单",
          "根据随后提供的自然环境观察记录，归纳问题类型、出现区域和变化趋势，形成后续跟踪时间线",
          "比较随后提供的多项生态保护建议，按照实施难度、预期影响和村民参与条件筛选出优先方案",
          "将随后提供的村级活动、维护事项和参与人员条件整理成一份分工明确的社区行动计划",
          "核对随后提供的公共设施需求与环境维护要求，找出重复、遗漏和相互冲突的事项并重新排序"
        ],
        "混合型": [
          "结合公共卫生和生态保护的一般原则，判断随后提供的几种生活垃圾处理方案哪种更适合当地条件",
          "依据水资源管理的基本判断框架，分析随后提供的用水记录和村民需求，确定需要优先协调的矛盾",
          "参考防灾减灾的一般做法，比较随后提供的不同家庭和公共区域条件，调整乡村极端天气应对安排",
          "运用公共设施规划中关于便利性、风险和生态影响的权衡方法，评估随后提供的候选位置并提出选择依据",
          "结合环境沟通和社区参与的通用方法，复盘随后提供的宣传活动反馈，调整下一轮自然保护行动的重点"
        ],
        "常识问答": [
