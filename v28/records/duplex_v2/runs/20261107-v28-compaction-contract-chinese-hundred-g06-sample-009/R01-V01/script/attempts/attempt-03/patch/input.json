    "situation_knowledge": {
      "episode_situation": "周六晚上，用户独自在家中餐桌旁使用手机，窗外下着雨，桌边的小风扇持续运转，公寓走廊偶尔传来脚步声。她最近在缴费、设置通知和填写表单时，常把外形相近的控件混在一起，因此现在想先弄懂按钮、开关、复选框、下拉菜单和标签页的基本区别。她已在纸上记下这些名称，并特别留意控件能否点击、是否显示当前状态、操作后会不会立即生效以及是否还藏有选项。手机在手边，但没有共享具体画面；她可以按需口述文字、图标和排列，希望用通俗说法逐项理解，并形成面对陌生图标时先看文字、位置、状态与操作风险的判断顺序。",
      "task_reference_data": [],
      "environment_audio": "左侧约两米处的小风扇发出稳定而低沉的转动声，音量基本不变。窗外连续雨声隔着玻璃传入，偶有稍密的雨点轻敲窗面。",
      "estimated_snr_db": 27,
      "constraints": [
        {
          "constraint_id": "C01",
          "text": "讲解需覆盖按钮、开关、复选框、下拉菜单与标签页的典型外观、主要作用和常见状态提示。",
          "kind": "hard"
        },
        {
          "constraint_id": "C02",
          "text": "遇到界面设计术语时，优先换成日常用语并配合简短例子说明。",
          "kind": "soft"
        },
        {
          "constraint_id": "C03",
          "text": "判断陌生控件时不能只依赖颜色或单个图标，应结合附近文字、所在位置、状态变化和操作后果。",
          "kind": "hard"
        }
      ],
      "safety_limits": [
        {
          "limit_id": "L01",
          "text": "若陌生控件可能触发付款、提交、删除、授权或退出，不应仅为试探含义而直接点击，应先核对标签、提示和返回路径。",
          "severity": "advisory"
        }
