{
  "episode_situation": "周六晚上，用户独自在出租屋洗衣区，前开门洗衣机在脱水时剧烈晃动并敲击机身；她已取消程序并拔下插头，准备在再次使用前排查。她维修经验有限，手边有短气泡水平尺，可检查机身水平、支脚和地面接触，但未经房东同意不能拆机。她想区分机器摆放、衣物负载不均与需检修的故障，并确认何时可低风险试机、何时应停机联系房东。",
  "task_reference_data": [
    "来自用户刚才的亲眼观察，尚未向助手完整说明：敲击声在排水结束、滚筒开始明显加速后出现，低速翻滚和进水时没有听到同样的声音。",
    "来自用户对本次衣物的回忆，当前可口头核对：滚筒内有一件双人被套、两条浴巾和四件短袖，被套取出时有一条浴巾卷在其中，衣物没有超过门口标示的最大装载线。",
    "来自用户现场检查并记下的情况，仍需结合通用排查原则判断：机器没有焦味、冒烟或可见漏水，门封处也未夹住衣物；洗衣机此前数次洗少量日常衣物时未出现如此剧烈的晃动。"
  ],
  "environment_audio": "头顶排风扇持续发出低而稳定的机械风声，位于用户上方。右侧磨砂窗外有均匀细雨声，偶尔略微增强，但不盖过近距离说话。",
  "estimated_snr_db": 26,
  "constraints": [
    {
      "constraint_id": "C01",
      "text": "洗衣机属于出租屋配套设备，用户未经房东同意不能拆卸外壳、配重或内部部件。",
      "kind": "hard"
    },
    {
      "constraint_id": "C02",
      "text": "排查应优先采用观察、重新分布衣物、检查水平和确认支脚接触等低风险且可恢复的方法。",
      "kind": "soft"
    }
  ],
  "safety_limits": [
    {
      "limit_id": "L01",
      "text": "若再次出现机器明显移位、剧烈撞击，或发现漏水、焦味、冒烟、火花、金属摩擦声、滚筒明显松旷，应立即停止运行并断电，不再继续试机。",
      "severity": "critical"
    },
    {
      "limit_id": "L02",
      "text": "机器运行时不得伸手扶住滚筒或机身底部，也不得在通电或转动状态下调整支脚、移动机器或触碰后方管线。",
      "severity": "hard"
    },
    {
      "limit_id": "L03",
      "text": "涉及拆除面板、检查悬挂弹簧、减震器、配重、轴承或电气部件的工作，应交由获得房东授权的维修人员处理。",
      "severity": "hard"
    }
  ],
