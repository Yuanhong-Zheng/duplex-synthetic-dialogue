    "situation_knowledge": {
      "episode_situation": "傍晚，用户独自在家中厨房准备加热一份冷藏饭菜，微波炉接通电源后显示屏仍然亮着，但按下平时使用的启动键后没有开始加热，也没有听见转盘或风扇运转。用户已经取出饭菜并停下操作，现场没有烟、火花、焦煳味或插头破损等明显危险迹象。由于难以看清面板上的小图标，用户只能确认屏幕有显示，尚不能确定炉门是否完全扣紧、是否亮着锁定或暂停提示、计时是否设为零，以及启动键按下时显示有没有变化。手边没有说明书，也没有其他人在场协助查看，因此现在需要按优先顺序口头确认这些外部现象，先判断更像安全联锁、操作遗漏，还是应停止使用并进一步检查的异常。",
      "task_reference_data": [],
      "environment_audio": "厨房里整体安静，近处只有极轻的室内底噪。没有持续的家电运转声或突发声响。",
      "estimated_snr_db": 34,
      "constraints": [
        {
          "constraint_id": "C01",
          "text": "判断应以炉门、面板提示、启动键反馈和计时显示等外部可观察现象为依据，不把尚未看清的图标当作已确认状态。",
          "kind": "hard"
        },
        {
          "constraint_id": "C02",
          "text": "口头引导优先给出最关键的一项观察，并使用便于定位和想象的简短描述。",
          "kind": "soft"
        }
      ],
      "safety_limits": [
        {
          "limit_id": "L01",
          "text": "不得拆开微波炉外壳、触碰内部线路或尝试自行维修高压部件；微波炉断电后内部仍可能存在危险高压。",
          "severity": "critical"
        },
        {
          "limit_id": "L02",
          "text": "如果出现烟、火花、焦煳味、异常巨响、漏电迹象或电源线损坏，应立即停止使用并在安全情况下断开电源。",
          "severity": "critical"
