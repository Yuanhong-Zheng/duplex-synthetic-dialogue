  "situation_knowledge": {
    "episode_situation": "今晚，用户从社区羽毛球馆回到家，独自在安静的客厅休息；他刚开始自己安排每周锻炼，对运动后的身体反应不太有把握。刚才一局结束后，他停下来时短暂觉得头发飘，坐下休息并喝了几口随身水后已经缓解，此刻没有继续运动。这个经历让他既想了解常见的短暂不适，也担心下次若伴随更严重的表现，会错过停止活动和求助的时机。症状持续时间、当时是否空腹或闷热，以及有无心悸胸痛、视物异常、明显气短、头痛、乏力或再次发作等细节尚未系统回想，他也不清楚缓解后该观察多久、何时能恢复轻活动，以及哪些情况应尽快就医。",
    "task_reference_data": [],
    "environment_audio": "客厅内整体安静，远近均无持续可辨的声源。只有极轻微且平稳的室内底噪，不影响语音交流。",
    "estimated_snr_db": 35,
    "constraints": [],
    "safety_limits": [
      {
        "limit_id": "L01",
        "text": "运动中再次出现头晕、站立不稳或接近晕厥时，应立即停止活动并转移到安全位置，不应勉强继续运动或独自驾车。",
        "severity": "hard"
      },
      {
        "limit_id": "L02",
        "text": "若头晕伴随昏厥、胸痛、严重呼吸困难、单侧无力或麻木、言语含糊、突发剧烈头痛，或症状持续加重，应立即寻求现场帮助和紧急医疗救助。",
        "severity": "critical"
      },
      {
        "limit_id": "L03",
        "text": "即使症状已经缓解，若反复发生、原因不明或影响正常活动，也不应仅靠自行补水后恢复高强度运动，宜暂停训练并接受医疗评估。",
        "severity": "advisory"
      }
    ],
