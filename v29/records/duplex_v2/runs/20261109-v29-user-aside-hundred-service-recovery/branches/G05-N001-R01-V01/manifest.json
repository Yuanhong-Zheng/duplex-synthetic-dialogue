      "scenario": "家电设置说明",
      "example_tasks": {
        "开放式互动": [
          "通过口头问答练习判断一台常见家电在首次设置前通常需要确认哪些条件",
          "扮演家电使用者与安装指导员，共同演练从开箱到首次运行的通用设置流程",
          "讨论家电设置中安全、节能、便捷和隐私之间通常如何取舍",
          "共同创作一份适合口头讲解的家电首次使用说明，让步骤清楚且容易记忆",
          "弄清楚阅读家电说明书时如何快速找到安装、联网、模式设置和日常维护等关键信息"
        ],
        "结构化整理": [
          "核对家电说明书片段与现场安装条件，整理成按顺序执行的设置步骤清单",
          "比较多个模式或功能选项及其说明，按适用场景汇总成选择表",
          "识别插座、摆放位置和配件准备情况中的缺口，分别归入已具备、待补齐和需确认的项目",
          "重建零散的设置过程记录与提示信息，按发生顺序整理成可回溯的排查时间线",
          "将家电设置笔记、注意事项和维护要求分类归档，形成安装、首次运行与日常使用清单"
        ],
        "混合型": [
          "先建立家电功能选项的通用取舍标准，再根据具体需求判断说明书中的配置应如何选择",
          "核对通风、供电和安全距离等通用摆放规则后，依据实际空间条件判断可行的放置方案",
          "从隐私、便利性和维护成本的一般判断框架出发，结合家庭使用情况权衡是否启用联网功能",
          "按照操作难度与安全原则设计通用的首次设置流程，再根据家庭成员的能力和使用习惯调整执行顺序",
          "定位说明书与实际现象之间可能产生冲突的通用排障环节，并依据设置记录、现象描述和已尝试步骤判断应优先核对的方向"
        ],
        "常识问答": [
          "想弄明白新家电第一次使用前通常要做哪些基础设置，以及哪些步骤不能省略",
          "家电面板上的常见图标分别代表什么，遇到看不懂的标志时该怎么判断其功能",
          "同一台家电的自动模式和手动模式有什么区别，日常使用时应如何选择",
          "家电连接无线网络时总是失败，想从常见设置误区入手判断问题可能出在哪里",
          "如果家电支持儿童锁、定时和节能等功能，它们分别适合什么情况，哪些设置不宜同时使用"
        ]
      },
