  "situation_knowledge": {
    "episode_situation": "傍晚，用户独自在家中生活阳台的洗衣机旁准备洗衣，两个年幼孩子正在客厅活动，因此他想先弄清童锁再开机。洗衣机目前断电且滚筒为空，用户已看到面板上的按键、锁形图标和组合按键标线，但不确定童锁与机门锁是不是同一功能。手边只有一张折叠的快速指南，没有完整说明书，也无法请助手查询机型资料。眼下需要先理解常见设置和解除逻辑，再根据面板文字核对这台机器适用的操作，同时确认应在待机还是运行状态下验证、怎样观察是否生效以及断电后设置是否保留。",
    "task_reference_data": [
      "用户已现场看清面板从左到右有“电源”“启动/暂停”“水温”“漂洗”四个按键；“水温”和“漂洗”之间有连接标线，下方印着锁形图标和“3秒”。",
      "显示区右上角有一个目前未点亮的小锁图标；机门把手附近另有“运行中请勿强行开门”的印字，用户尚不确定二者是否都代表童锁。",
      "手边快速指南可现场翻读，其中童锁条目写着：“开机后，同时长按水温和漂洗3秒；锁形指示灯亮起后，除电源键外其他按键不可用。”指南这一页没有说明断电后是否保留设置。"
    ],
    "environment_audio": "生活阳台上方的换气扇从右上方持续发出低而平稳的机械风声，音量较轻。远处客厅偶有模糊的居家动静，但听不清任何说话内容。",
    "estimated_snr_db": 29,
    "constraints": [
      {
        "constraint_id": "C01",
        "text": "针对这台洗衣机判断具体按键操作时，只能依据用户现场可见的面板印字和快速指南，不把其他机型的组合键直接套用过来。",
        "kind": "hard"
      },
      {
        "constraint_id": "C02",
        "text": "需要明确区分童锁对控制按键的限制与运行时机门锁定，避免把锁形标识一概视为同一功能。",
        "kind": "hard"
      }
    ],
    "safety_limits": [
