  "situation_knowledge": {
    "episode_situation": "周日晚上九点，用户坐在合租公寓的客厅里，同居伴侣正在几米外的厨房收拾，两人刚因伴侣晚回家却没有提前发消息而发生争执。用户提出自己一直等消息、感到被忽略后，对方用“你太敏感”回应，随后双方开始争论谁反应过度，原本要谈的失约问题反而被搁置。用户已经在手机备忘录中记下约定、当时的几句原话和一版措辞，但不确定这种回应为何容易激化冲突，也担心自己开口时用了概括和指责。现在用户想趁双方暂时分开冷静时弄清其中的沟通机制，并逐步练习怎样区分事实、感受、需要和请求，以及当对方再次否定感受时如何把话题拉回具体事件，而不把讨论扩大成对整段关系或人格的判定。",
    "task_reference_data": [
      "来自用户手机备忘录、用户已经读过：两人此前约定，若晚饭时间会推迟，应尽量提前发一条消息；这次伴侣比原定时间晚了约50分钟，期间没有消息。",
      "来自用户对刚才争执的回忆、措辞可能并非逐字准确：用户先说“你怎么又不说一声，我一直在等”，伴侣回答“你太敏感了，我只是晚回来一会儿”。",
      "来自用户尚未定稿的备忘录草稿、用户当前可现场读取：“你这样让我很没安全感”“我希望下次晚回来时告诉我一声”；用户不确定前一句是否仍显得在归咎对方。"
    ],
    "environment_audio": "窗外持续的雨声从客厅右侧窗户传来，强弱较平稳，偶尔稍微密集。客厅里的落地扇在近处发出低而连续的机械声，整体不盖过近距离说话。",
    "estimated_snr_db": 24,
    "constraints": [
      {
        "constraint_id": "C01",
        "text": "讨论优先围绕这次晚回家且未发消息的具体事件，不直接推断伴侣的人格、动机或整段关系的性质。",
        "kind": "soft"
      },
      {
        "constraint_id": "C02",
        "text": "练习措辞时应尽量使用可观察的事实、第一人称感受和明确请求，避免“总是”“从不”等绝对化表达。",
        "kind": "hard"
      },
      {
        "constraint_id": "C03",
        "text": "需要区分承认感受确实存在与同意对事件的全部解释，不能把两者混为一谈。",
        "kind": "soft"
