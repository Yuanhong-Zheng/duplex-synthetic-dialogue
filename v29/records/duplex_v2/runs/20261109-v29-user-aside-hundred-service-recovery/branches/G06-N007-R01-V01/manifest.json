      "scenario": "设备安装设置",
      "example_tasks": {
        "开放式互动": [
          "通过口头问答练习为新设备制定一套通用的首次设置思路，并讨论常见取舍。",
          "讨论从设备开箱到基本可用的通用设置流程，并分析各阶段需要关注的问题。",
          "共同创作一份面向非技术用户的设备安装注意事项清单，重点解释每一步背后的原因。",
          "从一次设备设置不顺利的经历出发，复盘可能的认知误区并练习如何逐步定位问题。",
          "进行一轮设备设置情境挑战，讨论网络连接、权限配置和隐私选择之间的关系。"
        ],
        "结构化整理": [
          "根据我随后提供的安装步骤和注意事项，把内容整理成按先后顺序排列的设置清单。",
          "把我提供的设备要求、连接方式和限制条件分类整理，形成安装前的准备事项与检查表。",
          "比较我随后列出的几种安装方案，按兼容性、复杂度和维护便利性整理出优先顺序。",
          "核对我提供的设置记录与目标配置，整理出已经完成、尚待处理和需要复查的项目。",
          "将我提供的多个设备安装问题按现象、可能环节和处理优先级归类，形成排障时间线。"
        ],
        "混合型": [
          "结合通用的首次设置原则和我随后提供的设备环境，判断应采用怎样的安装顺序。",
          "面对我列出的几种连接与权限配置选择，运用安全性和易用性的判断框架确定更合适的方案。",
          "根据通用兼容性规则和我提供的设备、系统及网络条件，筛选可行的安装路径。",
          "我会描述一次安装过程中出现的现象和已尝试的步骤，希望结合常见排障思路判断下一步应优先核对什么。",
          "结合设备设置中的隐私与便利性取舍，以及我随后说明的使用习惯和家庭环境，调整出适合我的配置方案。"
        ],
        "常识问答": [
          "想弄明白新设备第一次开机时通常要先设置哪些内容，以及哪些设置可以之后再改",
          "家里安装无线打印机时遇到连接不上网络的问题，想知道可以从哪些现象判断是网络、配对还是权限设置导致的",
          "想比较蓝牙配对和连接无线网络在设备设置上的区别，并顺便了解为什么有些设备两者都需要",
          "准备给家人设置一台智能音箱，想知道语音唤醒、网络连接和账号绑定分别起什么作用",
          "想通过一个简单例子弄清楚设备恢复出厂设置和重新启动有什么不同，以及什么情况下适合选择前者"
        ]
      },
