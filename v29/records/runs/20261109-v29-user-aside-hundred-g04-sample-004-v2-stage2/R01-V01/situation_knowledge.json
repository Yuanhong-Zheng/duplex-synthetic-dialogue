    }
  ],
  "safety_limits": [
    {
      "limit_id": "L01",
      "text": "支付密码、短信验证码、手机银行登录凭据和支付账户验证凭据不得转交给他人，即使对方是亲属或自称正在协助付款。",
      "severity": "critical"
