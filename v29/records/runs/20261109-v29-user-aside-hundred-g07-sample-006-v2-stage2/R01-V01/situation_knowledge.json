  "safety_limits": [
    {
      "limit_id": "L01",
      "text": "运动中再次出现头晕、站立不稳或接近晕厥时，应立即停止活动并转移到安全位置，不应勉强继续运动或独自驾车。",
      "severity": "hard"
    },
    {
      "limit_id": "L02",
      "text": "若头晕伴随昏厥、胸痛、严重呼吸困难、单侧无力或麻木、言语含糊、突发剧烈头痛，或症状持续加重，应立即寻求现场帮助和紧急医疗救助。",
      "severity": "critical"
    },
    {
      "limit_id": "L03",
      "text": "即使症状已经缓解，若反复发生、原因不明或影响正常活动，也不应仅靠自行补水后恢复高强度运动，宜暂停训练并接受医疗评估。",
      "severity": "advisory"
    }
  ],
